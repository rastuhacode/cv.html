<!-- The template is written with handlebars (https://handlebarsjs.com) -->
<!-- You can use `cv` object to render data you created in `Content` tab -->

<body class="bg-white">
  <article
    lang="en"
    class="resume mx-auto w-[210mm] min-h-[297mm] bg-white text-black text-[10pt] leading-snug px-[14mm] py-[12mm] flex flex-col gap-4"
  >
    <!-- ── Header ───────────────────────────────────────────── -->
    <header class="flex items-stretch gap-5">
      <div
        class="grow min-w-0 border-[3px] border-black bg-yellow-300 p-4"
        style="box-shadow: 6px 6px 0 #000"
      >
        <h1
          class="text-[28pt] font-black uppercase leading-none tracking-tight"
        >
          {{cv.name}}
        </h1>
        {{#if cv.title}}
        <p
          class="mt-1 text-[12pt] font-bold uppercase bg-black text-yellow-300 inline-block px-2 py-0.5"
        >
          {{cv.title}}
        </p>
        {{/if}}
      </div>
      {{#if cv.picture}}
      <img
        src="{{cv.picture}}"
        alt="{{cv.name}}"
        class="shrink-0 size-[28mm] object-cover border-[3px] border-black"
        style="box-shadow: 6px 6px 0 #000"
      />
      {{/if}}
    </header>

    {{#if cv.contacts}}
    <nav
      class="flex flex-wrap items-center gap-x-2 gap-y-1 border-[3px] border-black px-2 py-1.5"
      aria-label="Contact"
    >
      {{#each cv.contacts}}
      <a
        href="{{this.url}}"
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline inline-flex items-center gap-1 hover:bg-yellow-300 whitespace-nowrap"
      >
        <span
          class="text-[7pt] font-black uppercase leading-none bg-black text-yellow-300 px-1 py-0.5"
        >{{this.label}}</span>
        {{#if this.value}}
        <span class="text-[8pt] font-bold">{{this.value}}</span>
        {{/if}}
      </a>
      {{/each}}
    </nav>
    {{/if}}

    <!-- ── Profile ────────────────────────────────────────── -->
    {{#if cv.profile}}
    <section>
      <h2
        class="text-[12pt] font-black uppercase bg-black text-white inline-block px-3 py-1 mb-2.5"
      >
        {{#if cv.labels.profile}}{{cv.labels.profile}}{{else}}Profile{{/if}}
      </h2>
      <div class="flex flex-col gap-2 border-l-[3px] border-black pl-3">
        {{#each cv.profile}}
        <p>{{{this}}}</p>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- ── Experience ─────────────────────────────────────── -->
    {{#if cv.experience}}
    <section>
      <h2
        class="text-[12pt] font-black uppercase bg-black text-white inline-block px-3 py-1 mb-3"
      >
        {{#if
        cv.labels.experience}}{{cv.labels.experience}}{{else}}Experience{{/if}}
      </h2>
      <div class="flex flex-col gap-3.5">
        {{#each cv.experience}}
        <article
          class="border-[3px] border-black p-3"
          style="box-shadow: 5px 5px 0 #000"
        >
          <div class="flex justify-between items-baseline gap-3">
            {{#if this.company}}
            <div class="text-[11pt] font-bold uppercase flex gap-1 items-baseline">
              {{#if this.companyUrl}}
              <span class="font-black uppercase text-[11pt]">{{this.role}}</span>
              <span class="text-[8pt]">{{this.at}}</span>
              <a
                href="{{this.companyUrl}}"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-[3px] hover:bg-yellow-300"
              >
                {{this.company}}
              </a>
              {{else}}{{this.company}}{{/if}}
            </div>
            {{/if}}
            <span
              class="shrink-0 text-[8.5pt] font-bold bg-yellow-300 border-2 border-black px-1.5 whitespace-nowrap"
            >
              {{this.period}}
            </span>
          </div>

          {{#if this.description}}
          <p class="mt-1">{{{this.description}}}</p>
          {{/if}} {{#if this.highlights}}
          <ul class="mt-1.5 flex flex-col gap-1">
            {{#each this.highlights}}
            <li class="flex gap-2 break-inside-avoid">
              <span class="shrink-0 font-black">■</span><span>{{{this}}}</span>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- ── Skills ─────────────────────────────────────────── -->
    {{#if cv.skills}}
    <section>
      <h2
        class="text-[12pt] font-black uppercase bg-black text-white inline-block px-3 py-1 mb-2.5"
      >
        {{#if cv.labels.skills}}{{cv.labels.skills}}{{else}}Skills{{/if}}
      </h2>
      <ul class="border-l-[3px] border-black">
        {{#each cv.skills}}
        <li class="flex items-baseline gap-2 px-2.5 py-1 leading-snug">
          <span class="shrink-0 font-black uppercase">
            <span
              class="text-[8pt] leading-none bg-yellow-300 border-2 border-black text-black px-1.5 py-0.5"
            >{{this.category}}</span><span class="text-[8pt] text-white">:</span>
          </span>
          <span class="min-w-0">{{this.items}}</span>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    <!-- ── Education ───────────────────────────────────────── -->
    {{#if cv.education}}
    <section>
      <h2
        class="text-[12pt] font-black uppercase bg-black text-white inline-block px-3 py-1 mb-3"
      >
        {{#if
        cv.labels.education}}{{cv.labels.education}}{{else}}Education{{/if}}
      </h2>
      <div class="flex flex-col gap-3">
        {{#each cv.education}}
        <article
          class="border-[3px] border-black p-3"
          style="box-shadow: 5px 5px 0 #000"
        >
          <div class="flex justify-between items-baseline gap-3">
            <h3 class="font-black uppercase text-[11.5pt]">
              {{#if this.institutionUrl}}<a
                href="{{this.institutionUrl}}"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-[3px] hover:bg-yellow-300"
              >
                {{this.institution}}
              </a>
              {{else}}{{this.institution}}{{/if}}
            </h3>
            <span
              class="shrink-0 text-[8.5pt] font-bold bg-yellow-300 border-2 border-black px-1.5 whitespace-nowrap"
            >
              {{this.period}}
            </span>
          </div>
          {{#if this.degree}}
          <p class="font-bold">{{this.degree}}</p>
          {{/if}} {{#if this.highlights}}
          <ul class="mt-1 flex flex-col gap-1">
            {{#each this.highlights}}
            <li class="flex gap-2">
              <span class="shrink-0 font-black">■</span><span>{{{this}}}</span>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- ── Languages ───────────────────────────────────────── -->
    {{#if cv.languages}}
    <section>
      <h2
        class="text-[12pt] font-black uppercase bg-black text-white inline-block px-3 py-1 mb-2.5"
      >
        {{#if
        cv.labels.languages}}{{cv.labels.languages}}{{else}}Languages{{/if}}
      </h2>
      <div class="flex flex-wrap gap-2">
        {{#each cv.languages}}
        <span
          class="text-[9.5pt] font-bold uppercase border-[3px] border-black px-3 py-0.5"
          style="box-shadow: 3px 3px 0 #000"
        >
          {{this.name}} / {{this.level}}
        </span>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </article>
</body>
